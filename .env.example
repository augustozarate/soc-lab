# ==========================================
# SOC Lab - Environment configuration
# ==========================================

# Optional external threat-intelligence API keys.
#
# Leave these values empty when external providers
# are not configured. The runtime can continue using
# local and heuristic threat-intelligence sources.
ABUSE_KEY=
VT_KEY=


# ==========================================
# Threat Intelligence - Network Preflight
# ==========================================

# Enable the fast external-connectivity preflight.
#
# Accepted true values:
# 1, true, yes, on
#
# Any other explicit value is interpreted as false.
THREAT_INTEL_PREFLIGHT_ENABLED=true

# TCP endpoint used only to determine whether external
# connectivity is available before provider lookups.
THREAT_INTEL_PREFLIGHT_HOST=1.1.1.1
THREAT_INTEL_PREFLIGHT_PORT=443

# Maximum preflight connection time in seconds.
THREAT_INTEL_PREFLIGHT_TIMEOUT=0.10

# ==========================================
# Automated Response
# ==========================================

# Safe default:
#
# simulate -> record response decisions only
# enforce  -> execute supported response backends
#
# Keep simulate enabled until the enforcement
# backend has been validated for the environment.
RESPONSE_MODE=simulate

# Comma-separated IPv4 targets that automated
# BLOCK_IP actions must never enforce against.
#
# Example for this lab:
# Windows protected host = 192.168.20.128
RESPONSE_PROTECTED_IPS=192.168.20.128

# Temporary automated BLOCK_IP lifetime.
#
# Value is expressed in seconds and must be > 0.
#
# Default:
# 900 seconds = 15 minutes
RESPONSE_BLOCK_TTL_SECONDS=900
